{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "framework": "create-react-app",
  "env": {
    "REACT_APP_AUTH0_DOMAIN": "@auth0_domain",
    "REACT_APP_AUTH0_CLIENT_ID": "@auth0_client_id",
    "REACT_APP_AUTH0_CALLBACK_URL": "http://legacy-alpha-seven.vercel.app/callback",
    "REACT_APP_AUTH0_AUDIENCE": "@auth0_audience",
    "REACT_APP_API_SERVER_URL": "http://legacy-alpha-seven.vercel.app"
  },
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/favicon.ico"
    },
    {
      "src": "/manifest.json",
      "dest": "/manifest.json"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
} 